msgid "Bottom Right"
msgstr "Dole desno"

#: src/assets/dist/settings/base.js:9
msgid "Bottom Left"
msgstr "Dole levo"

#: src/assets/dist/settings/base.js:9
msgid "None"
msgstr "Nema"

#: src/assets/dist/settings/base.js:9
msgid "Position of the floating button on mobile devices. Mobile filters must be enabled first"
msgstr ""
"Pozicija plutajućeg dugmeta na mobilnim uređajima. Mobilni filteri moraju "
"prvo biti uključeni"

#: src/assets/dist/settings/base.js:9
msgid "Show terms count"
msgstr "Prikaži broj termina"

#: src/assets/dist/settings/base.js:9
msgid "Show the count of products in a category"
msgstr "Prikaži broj proizvoda u kategoriji"

#: src/assets/dist/settings/base.js:9
msgid "Dynamic recount"
msgstr "Dinamičko prebrojavanje"

#: src/assets/dist/settings/base.js:9
msgid "Count the numbers of products in a category depending on the currently selected filters"
msgstr "Broji proizvode u kategoriji u zavisnosti od trenutno izabranih filtera"

#: src/assets/dist/settings/base.js:9
msgid "Hide Empty"
msgstr "Sakrij prazne"

#: src/assets/dist/settings/base.js:9
msgid "Hide categories with 0 products"
msgstr "Sakrij kategorije sa 0 proizvoda"

#: src/assets/dist/settings/base.js:9
msgid "Selected First"
msgstr "Izabrani prvo"

#: src/assets/dist/settings/base.js:9
msgid "Show selected filters on top"
msgstr "Prikaži izabrane filtere na vrhu"

#: src/assets/dist/settings/base.js:9
msgid "Autosubmit"
msgstr "Automatska primena"

#: src/assets/dist/settings/base.js:9
msgid "Apply a filter immediatelly after it's toggled on or off"
msgstr "Primeni filter odmah nakon što se uključi ili isključi"

#: src/assets/dist/settings/base.js:9
msgid "AJAX Reload"
msgstr "AJAX osvežavanje"

#: src/assets/dist/settings/base.js:9
msgid "Apply filters without refreshing the page"
msgstr "Primeni filtere bez osvežavanja stranice"

#: src/assets/dist/settings/base.js:9
msgid "Infinity loading"
msgstr "Beskonačno učitavanje"

#: src/assets/dist/settings/base.js:9
msgid "Load products at the bottom of the list instead of going to a next page. Removes the pagination and adds a button to load more products at the end of the list."
msgstr ""
"Učitaj proizvode na dnu liste umesto prelaska na sledeću stranicu. Uklanja "
"paginaciju i dodaje dugme za učitavanje još proizvoda na kraju liste."

#: src/assets/dist/settings/base.js:9
msgid "Loader animation"
msgstr "Animacija učitavanja"

#: src/assets/dist/settings/base.js:9
msgid "Add loader animation while the next page of products is loading in AJAX mode"
msgstr ""
"Prikaži animaciju učitavanja dok se sledeća stranica proizvoda učitava u "
"AJAX režimu"

#: src/assets/dist/settings/base.js:9
msgid "Mobile Filters"
msgstr "Mobilni filteri"

#: src/assets/dist/settings/base.js:9
msgid "Move the filtrers on mobile to a fullscreen popup and add a floating button to open and close the popup"
msgstr ""
"Premesti filtere na mobilnom u popup preko celog ekrana i dodaj plutajuće "
"dugme za otvaranje i zatvaranje"
